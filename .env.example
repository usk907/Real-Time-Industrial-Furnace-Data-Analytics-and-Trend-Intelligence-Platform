# ======================================================================
# Industrial Energy Intelligence Platform (IEIP) - Environment Config
# Copy this file to '.env' and customize values for your deployment.
# ======================================================================

# ----------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ----------------------------------------------------------------------
# SQLite Local Fallback:
# DATABASE_URL=sqlite:///./furnace.db

# TimescaleDB / PostgreSQL (Local or Docker):
DATABASE_URL=postgresql://admin:securepassword@localhost:5432/furnace_db

# MySQL / TiDB Cloud:
# DATABASE_URL=mysql+pymysql://root:password@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/furnace_db

# PostgreSQL Docker credentials
POSTGRES_USER=admin
POSTGRES_PASSWORD=securepassword
POSTGRES_DB=furnace_db

# Dedicated TAP Ingestion Server Target Database (defaults to DATABASE_URL if unset)
TAP_DATABASE_URL=postgresql://admin:securepassword@localhost:5432/furnace_db

# ----------------------------------------------------------------------
# 2. TIME-SERIES HISTORIAN & CACHE
# ----------------------------------------------------------------------
# InfluxDB 2.7+ Time-Series Engine
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=my-super-secret-admin-token-1234567890
INFLUXDB_ORG=ieip_org
INFLUXDB_BUCKET=furnace_telemetry

# Redis Token & State Cache
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------------
# 3. FASTAPI BACKEND SERVER (Port 8000)
# ----------------------------------------------------------------------
PROJECT_NAME="Industrial Energy Intelligence Platform (IEIP)"
API_V1_STR=/api
SECRET_KEY=SUPER_SECRET_INDUSTRIAL_KEY_9812A7C
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# URL used for sending password reset emails / links
FRONTEND_URL=http://localhost:5173

# Google Gemini API Key for Natural Language Control Room Copilot & text-to-SQL
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ----------------------------------------------------------------------
# 4. TAP INGESTION SERVER (Port 8001)
# ----------------------------------------------------------------------
TAP_SERVER_HOST=0.0.0.0
TAP_SERVER_PORT=8001

# ----------------------------------------------------------------------
# 5. SCADA TELEMETRY SIMULATOR
# ----------------------------------------------------------------------
TAP_HOST=127.0.0.1
TAP_PORT=8001
TAP_SERVER_URL=http://127.0.0.1:8001/tap/telemetry

# ----------------------------------------------------------------------
# 6. REACT FRONTEND (Vite / Capacitor Mobile)
# ----------------------------------------------------------------------
# Optional override for remote deployments (empty string uses relative proxy)
VITE_API_URL=
