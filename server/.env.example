# IEIP Server Configuration (Part 2)
# Connects to local MySQL as server_user (SELECT on readings, SELECT/INSERT/UPDATE on users/alarms)
DATABASE_URL=mysql+pymysql://server_user:ServerPassword123!@127.0.0.1:3307/furnace_db

# Security & Authentication (Generate a strong 32+ character hex or random key)
JWT_SECRET=replace_with_secure_random_key_min_32_characters_long
JWT_EXPIRE_MINUTES=1440

# Initial Admin User Setup (Created automatically on first startup if users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_secure_password_min_8_chars

# CORS (Comma-separated list of allowed web origins, never '*')
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,capacitor://localhost,http://localhost

# WebSocket Broadcast Cadence
WS_PUSH_INTERVAL_SECONDS=1.0
